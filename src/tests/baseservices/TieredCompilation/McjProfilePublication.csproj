<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The profile root is set once per process, and the tests replace the profile files. -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- No crossgen folder under Core_Root -->
    <NativeAotIncompatible>true</NativeAotIncompatible>
    <!-- Only CoreCLR's MulticoreJIT writes a profile. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' != 'coreclr'">true</CLRTestTargetUnsupported>
    <!-- MulticoreJIT does not record the methods of a collectible assembly. -->
    <UnloadabilityIncompatible>true</UnloadabilityIncompatible>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="McjProfilePublication.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
