<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestEnvironmentVariable -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- No crossgen folder under Core_Root -->
     <NativeAotIncompatible>true</NativeAotIncompatible>
    <!-- The test asserts the MCJ profile file is published; only CoreCLR's MulticoreJIT writes one. -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' != 'coreclr'">true</CLRTestTargetUnsupported>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="McjRecorderTimeoutBeforeStop.cs" />

    <CLRTestEnvironmentVariable Include="DOTNET_MultiCoreJitProfileWriteDelay" Value="1" />
    <!-- CLRConfig DWORD values default to hexadecimal: 0x7d0 is 2000 ms. -->
    <CLRTestEnvironmentVariable Include="DOTNET_MultiCoreJitProfileReadDelay"
                                Value="7d0"
                                Condition="'$(TestWrapperTargetsWindows)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
